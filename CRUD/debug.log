 destacar no PCM 2025."},"justificativa":{"2":"","4":"","5":"","7":""},"secretaria":{"14":["Administra\u00e7\u00e3o","Sa\u00fade","Educa\u00e7\u00e3o, cultura e esporte","Meio Ambiente e Agricultura","Controle Interno","Finan\u00e7as","Assist\u00eancia Social","Compras"]},"efetivos":{"14":["52","132","363","0","0","0","9","0"]},"comissionados":{"14":["68","37","98","2","4","2","18","1"]},"temporarios":{"14":["0","0","1","0","0","0","0","0"]},"salvar":""}
